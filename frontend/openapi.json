{
  "components": {
    "schemas": {
      "AuthUser": {
        "description": "All that other modules ever see of a user: no password hash, no ORM object.",
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "id",
          "username"
        ],
        "title": "AuthUser",
        "type": "object"
      },
      "CandidateOut": {
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "likes": {
            "title": "Likes",
            "type": "integer"
          },
          "match_score": {
            "title": "Match Score",
            "type": "number"
          },
          "my_vote": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "My Vote"
          },
          "place_id": {
            "title": "Place Id",
            "type": "string"
          },
          "rank": {
            "title": "Rank",
            "type": "integer"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "title": "Tags",
            "type": "array"
          }
        },
        "required": [
          "id",
          "place_id",
          "rank",
          "match_score",
          "tags",
          "likes",
          "my_vote"
        ],
        "title": "CandidateOut",
        "type": "object"
      },
      "CreateRoomIn": {
        "properties": {
          "display_name": {
            "examples": [
              "Hà"
            ],
            "maxLength": 30,
            "minLength": 1,
            "title": "Display Name",
            "type": "string"
          }
        },
        "required": [
          "display_name"
        ],
        "title": "CreateRoomIn",
        "type": "object"
      },
      "GeoPoint": {
        "properties": {
          "lat": {
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Lat",
            "type": "number"
          },
          "lng": {
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Lng",
            "type": "number"
          }
        },
        "required": [
          "lat",
          "lng"
        ],
        "title": "GeoPoint",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "JoinRoomIn": {
        "properties": {
          "display_name": {
            "examples": [
              "Hà"
            ],
            "maxLength": 30,
            "minLength": 1,
            "title": "Display Name",
            "type": "string"
          }
        },
        "required": [
          "display_name"
        ],
        "title": "JoinRoomIn",
        "type": "object"
      },
      "JoinedOut": {
        "description": "Returned exactly once. The client stores the token (per room code) and sends it back in\nthe `X-Participant-Token` header on every following request.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "is_host": {
            "title": "Is Host",
            "type": "boolean"
          },
          "participant_id": {
            "format": "uuid",
            "title": "Participant Id",
            "type": "string"
          },
          "participant_token": {
            "title": "Participant Token",
            "type": "string"
          }
        },
        "required": [
          "code",
          "participant_id",
          "participant_token",
          "is_host"
        ],
        "title": "JoinedOut",
        "type": "object"
      },
      "LoginIn": {
        "properties": {
          "password": {
            "title": "Password",
            "type": "string"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "title": "LoginIn",
        "type": "object"
      },
      "MatchCriteria": {
        "description": "Search criteria shared by AI Match, Group Session and Food Journey.",
        "properties": {
          "categories": {
            "description": "e.g. ['cafe', 'main_meal']",
            "items": {
              "type": "string"
            },
            "title": "Categories",
            "type": "array"
          },
          "mood": {
            "examples": [
              "quán yên tĩnh để học bài"
            ],
            "maxLength": 300,
            "minLength": 1,
            "title": "Mood",
            "type": "string"
          },
          "origin": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/GeoPoint"
              },
              {
                "type": "null"
              }
            ]
          },
          "price_max": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "VND per person",
            "title": "Price Max"
          },
          "price_min": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "VND per person",
            "title": "Price Min"
          },
          "radius_m": {
            "default": 2000,
            "maximum": 10000.0,
            "minimum": 200.0,
            "title": "Radius M",
            "type": "integer"
          }
        },
        "required": [
          "mood"
        ],
        "title": "MatchCriteria",
        "type": "object"
      },
      "MatchResponse": {
        "properties": {
          "backups": {
            "description": "up to 3 fallback places, best first; used by the 'Không hợp' button",
            "items": {
              "$ref": "#/components/schemas/MatchResult"
            },
            "title": "Backups",
            "type": "array"
          },
          "best": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MatchResult"
              },
              {
                "type": "null"
              }
            ],
            "description": "null when nothing matches the criteria"
          }
        },
        "required": [
          "best"
        ],
        "title": "MatchResponse",
        "type": "object"
      },
      "MatchResult": {
        "description": "A candidate plus the short reasons behind its score.\n\nInherited from PlaceCandidate: place_id, match_score (0..1, show it as round(score * 100) %),\ntags (3-4 short tags), distance_m (straight-line metres, None when the request has no origin).",
        "properties": {
          "avg_rating": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "mean of our own reviews (sheet + web), 1..5; null when the place has no review",
            "title": "Avg Rating"
          },
          "distance_m": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Distance M"
          },
          "match_score": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Match Score",
            "type": "number"
          },
          "place_id": {
            "title": "Place Id",
            "type": "string"
          },
          "price_per_person": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "estimated VND per person (median of the reviews); null if unknown",
            "title": "Price Per Person"
          },
          "reasons": {
            "description": "up to 4 ready-to-show Vietnamese lines (mood, distance, price, rating); a line is omitted when its data is missing. distance_m is straight-line: show it with a '~' or 'khoảng'",
            "items": {
              "type": "string"
            },
            "title": "Reasons",
            "type": "array"
          },
          "review_count": {
            "default": 0,
            "description": "number of visible reviews behind avg_rating",
            "title": "Review Count",
            "type": "integer"
          },
          "tags": {
            "description": "short system-generated tags",
            "items": {
              "type": "string"
            },
            "title": "Tags",
            "type": "array"
          }
        },
        "required": [
          "place_id",
          "match_score"
        ],
        "title": "MatchResult",
        "type": "object"
      },
      "ParticipantOut": {
        "properties": {
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "is_host": {
            "title": "Is Host",
            "type": "boolean"
          },
          "votes_cast": {
            "title": "Votes Cast",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "display_name",
          "is_host",
          "votes_cast"
        ],
        "title": "ParticipantOut",
        "type": "object"
      },
      "RegisterIn": {
        "properties": {
          "password": {
            "maxLength": 72,
            "minLength": 8,
            "title": "Password",
            "type": "string"
          },
          "username": {
            "examples": [
              "ha_nguyen"
            ],
            "pattern": "^[A-Za-z0-9_.]{3,30}$",
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "title": "RegisterIn",
        "type": "object"
      },
      "RejectIn": {
        "description": "'Không hợp': the client keeps the backup list, so the server stays stateless.",
        "properties": {
          "criteria": {
            "$ref": "#/components/schemas/MatchCriteria"
          },
          "reason": {
            "$ref": "#/components/schemas/RejectReason"
          },
          "rejected_place_id": {
            "title": "Rejected Place Id",
            "type": "string"
          },
          "remaining": {
            "description": "place_ids of the backups still available (client-side list)",
            "items": {
              "type": "string"
            },
            "maxItems": 10,
            "title": "Remaining",
            "type": "array"
          }
        },
        "required": [
          "criteria",
          "reason",
          "rejected_place_id",
          "remaining"
        ],
        "title": "RejectIn",
        "type": "object"
      },
      "RejectReason": {
        "enum": [
          "too_far",
          "too_expensive",
          "too_crowded",
          "wrong_vibe"
        ],
        "title": "RejectReason",
        "type": "string"
      },
      "RoomStateOut": {
        "properties": {
          "candidates": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/CandidateOut"
            },
            "title": "Candidates",
            "type": "array"
          },
          "changed": {
            "default": true,
            "title": "Changed",
            "type": "boolean"
          },
          "code": {
            "title": "Code",
            "type": "string"
          },
          "decided_by": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Decided By"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "majority_threshold": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Majority Threshold"
          },
          "me": {
            "format": "uuid",
            "title": "Me",
            "type": "string"
          },
          "participants": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/ParticipantOut"
            },
            "title": "Participants",
            "type": "array"
          },
          "poll_interval_ms": {
            "title": "Poll Interval Ms",
            "type": "integer"
          },
          "server_time": {
            "format": "date-time",
            "title": "Server Time",
            "type": "string"
          },
          "status": {
            "enum": [
              "lobby",
              "voting",
              "decided",
              "expired"
            ],
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          },
          "winner_place_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Winner Place Id"
          }
        },
        "required": [
          "code",
          "status",
          "version",
          "me",
          "expires_at",
          "server_time",
          "poll_interval_ms"
        ],
        "title": "RoomStateOut",
        "type": "object"
      },
      "StartIn": {
        "properties": {
          "criteria": {
            "$ref": "#/components/schemas/MatchCriteria"
          }
        },
        "required": [
          "criteria"
        ],
        "title": "StartIn",
        "type": "object"
      },
      "UserOut": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "created_at"
        ],
        "title": "UserOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VoteIn": {
        "properties": {
          "candidate_id": {
            "format": "uuid",
            "title": "Candidate Id",
            "type": "string"
          },
          "liked": {
            "title": "Liked",
            "type": "boolean"
          }
        },
        "required": [
          "candidate_id",
          "liked"
        ],
        "title": "VoteIn",
        "type": "object"
      },
      "WhyOut": {
        "description": "'Why this place?'. Separate endpoint because the LLM call is slow.",
        "properties": {
          "place_id": {
            "title": "Place Id",
            "type": "string"
          },
          "why": {
            "title": "Why",
            "type": "string"
          }
        },
        "required": [
          "place_id",
          "why"
        ],
        "title": "WhyOut",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "FoodMaps API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/auth/login": {
      "post": {
        "description": "Check credentials and set the session cookie.",
        "operationId": "login_api_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Login",
        "tags": [
          "M1 auth"
        ]
      }
    },
    "/api/auth/logout": {
      "post": {
        "description": "Clear the session cookie.",
        "operationId": "logout_api_auth_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "summary": "Logout",
        "tags": [
          "M1 auth"
        ]
      }
    },
    "/api/auth/me": {
      "get": {
        "description": "Called by the frontend on startup to tell guests from logged-in users (401 = guest).",
        "operationId": "me_api_auth_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthUser"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Me",
        "tags": [
          "M1 auth"
        ]
      }
    },
    "/api/auth/register": {
      "post": {
        "description": "Create an account and log in immediately (sets the session cookie).",
        "operationId": "register_api_auth_register_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "409": {
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Register",
        "tags": [
          "M1 auth"
        ]
      }
    },
    "/api/groups": {
      "post": {
        "description": "Create a room right away (criteria come later). The creator becomes the host.",
        "operationId": "create_room_api_groups_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRoomIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JoinedOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Room",
        "tags": [
          "M5 group session"
        ]
      }
    },
    "/api/groups/{code}": {
      "get": {
        "description": "Polling endpoint. If since_version == room.version, returns changed=False with an empty body.",
        "operationId": "get_state_api_groups__code__get",
        "parameters": [
          {
            "in": "path",
            "name": "code",
            "required": true,
            "schema": {
              "title": "Code",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "since_version",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Since Version"
            }
          },
          {
            "in": "header",
            "name": "X-Participant-Token",
            "required": true,
            "schema": {
              "title": "X-Participant-Token",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoomStateOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get State",
        "tags": [
          "M5 group session"
        ]
      }
    },
    "/api/groups/{code}/finalize": {
      "post": {
        "description": "Host ends voting early: the most-liked place wins (decided_by=\"host\").",
        "operationId": "finalize_api_groups__code__finalize_post",
        "parameters": [
          {
            "in": "path",
            "name": "code",
            "required": true,
            "schema": {
              "title": "Code",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-Participant-Token",
            "required": true,
            "schema": {
              "title": "X-Participant-Token",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoomStateOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "403": {
            "description": "Forbidden"
          },
          "409": {
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Finalize",
        "tags": [
          "M5 group session"
        ]
      }
    },
    "/api/groups/{code}/join": {
      "post": {
        "description": "Join the lobby. 409 if the room already started, is full or the name is taken; 410 if expired.",
        "operationId": "join_room_api_groups__code__join_post",
        "parameters": [
          {
            "in": "path",
            "name": "code",
            "required": true,
            "schema": {
              "title": "Code",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JoinRoomIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JoinedOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "Not Found"
          },
          "409": {
            "description": "Conflict"
          },
          "410": {
            "description": "Gone"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Join Room",
